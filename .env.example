# Copy to .env for local development. In production every secret comes from the secrets manager.
NODE_ENV=development
PORT=4000
# Runtime role (NOBYPASSRLS) — all tenant access goes through row-level security
DATABASE_URL=postgres://s360_app:s360_app_dev@localhost:5432/student360
# Owner role — migrations, tenant provisioning, outbox relay only
DATABASE_ADMIN_URL=postgres://s360_owner:s360_owner_dev@localhost:5432/student360
REDIS_URL=redis://localhost:6379
# bullmq (API + separate worker) | inline (single process; dev/tests)
JOB_MODE=inline
JWT_SECRET=change-me-to-a-random-64-char-secret-............................
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
PLATFORM_ADMIN_TOKEN=
# mock = deterministic offline provider; anthropic = Claude via the AI gateway
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Judge0-compatible isolated sandbox for coding tasks (never run student code on app hosts)
CODE_SANDBOX_URL=
CODE_SANDBOX_TOKEN=
